NEXT_PUBLIC_DOC_URL=https://docs.canvas.best

# SaaS backend
SERVER_API_URL=http://localhost:8085
# 1Panel 已有 PostgreSQL 时，优先创建独立数据库和独立用户，不要和 NewAPI 共用库。
# 同 Docker 网络可用容器连接地址，例如：
# DATABASE_URL=postgres://ic_user:你的密码@1Panel-postgresql-NamW:5432/infinite_canvas?sslmode=disable
DATABASE_URL=postgres://ic_user:你的密码@1Panel-postgresql-NamW:5432/infinite_canvas?sslmode=disable
# 如果使用上面的容器连接地址，应用容器需要加入 PostgreSQL 所在网络。
# 1Panel 常见网络名是 1panel-network，可用 docker network ls 确认。
ONEPANEL_NETWORK=1panel-network
SESSION_COOKIE_NAME=ic_session
SESSION_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=

# NewAPI
NEWAPI_BASE_URL=
NEWAPI_TOKEN=

# Media storage: local or r2
STORAGE_PROVIDER=local
MAX_UPLOAD_BYTES=52428800
LOCAL_STORAGE_DIR=data/media
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
